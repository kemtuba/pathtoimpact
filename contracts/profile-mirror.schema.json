{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of PUT /api/sync/v1/profiles.",
  "properties": {
    "profiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "example_titles": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "form": {
            "additionalProperties": false,
            "properties": {
              "employer_types": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "kinds": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "bar": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "label": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "bar",
                    "id",
                    "label"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "screens_default": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "tools": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "employer_types",
              "kinds",
              "screens_default",
              "tools"
            ],
            "type": "object"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "lookup_version": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "node": {
            "minLength": 1,
            "type": "string"
          },
          "pay_range": {
            "additionalProperties": false,
            "properties": {
              "currency": {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              "max": {
                "minimum": 0,
                "type": "number"
              },
              "min": {
                "minimum": 0,
                "type": "number"
              },
              "period": {
                "enum": [
                  "annual",
                  "hourly"
                ],
                "type": "string"
              }
            },
            "required": [
              "currency",
              "max",
              "min",
              "period"
            ],
            "type": "object"
          },
          "ruling_status": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "active",
              "demoted"
            ],
            "type": "string"
          },
          "version": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "description",
          "example_titles",
          "form",
          "id",
          "lookup_version",
          "name",
          "node",
          "ruling_status",
          "sha256",
          "status",
          "version"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "profiles"
  ],
  "title": "Profiles mirror",
  "type": "object",
  "x-contract-version": "1.0.0"
}
