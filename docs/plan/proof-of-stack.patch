+// Next 16 convention: `proxy.ts` replaces `middleware.ts` (which still works
+// but logs a deprecation warning; having both is a build error).
+// Optimistic redirect only: checks that a session cookie exists. The real
+// session check is auth.api.getSession() in the page.
+import { getSessionCookie } from "better-auth/cookies";
+import { NextResponse, type NextRequest } from "next/server";
+
+export function proxy(request: NextRequest) {
+  const sessionCookie = getSessionCookie(request);
+  if (!sessionCookie) {
+    return NextResponse.redirect(new URL("/", request.url));
+  }
+  return NextResponse.next();
+}
+
+export const config = {
+  matcher: ["/dashboard/:path*"],
+};
