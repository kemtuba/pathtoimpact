+import { createHash, timingSafeEqual } from "node:crypto";
+import { NextResponse } from "next/server";
+
+/** Constant-time compare that does not leak length: hash both sides first. */
+function tokenMatches(presented: string | null, expected: string | undefined): boolean {
+  if (!presented || !expected) {
+    return false;
+  }
+  const a = createHash("sha256").update(presented).digest();
+  const b = createHash("sha256").update(expected).digest();
+  return timingSafeEqual(a, b);
+}
+
+export async function GET(request: Request) {
+  const header = request.headers.get("authorization");
+  const presented = header?.startsWith("Bearer ") ? header.slice("Bearer ".length) : null;
+  if (!tokenMatches(presented, process.env.SYNC_TOKEN)) {
+    return NextResponse.json({ error: "unauthorized" }, { status: 401 });
+  }
+  return NextResponse.json({ ok: true, at: new Date().toISOString() });
+}
