# Copy to .env.local for local work. Real values live in the Vercel project
# and in the Claude Code environment; never commit them. See docs/setup.md.

# Needed at build time as well as at run time (better-auth initialises on import).
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Neon: pooled for queries, direct for migrations.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# Resend. Constructed per send, so builds do not need the key.
RESEND_API_KEY=re_xxx
EMAIL_FROM="pathtoimpact.us <no-reply@mail.pathtoimpact.us>"
EMAIL_REPLY_TO=

# Sync with the engine on Kem's Mac. Store hashes only: pnpm sync:token prints a token and its hash.
SYNC_TOKEN_SHA256=
SYNC_TOKEN_SHA256_PREVIOUS=
# production on Vercel Production, staging on the staging branch, development locally.
SYNC_ENV=development

# Cron handlers refuse requests without this bearer secret.
CRON_SECRET=

OPERATOR_EMAIL=
OPERATOR_USER_ID=
DEFAULT_TIMEZONE=America/New_York
